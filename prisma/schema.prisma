// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider      = "prisma-client"
  output        = "./generated"
  compilerBuild = "small"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  isActive  Boolean  @default(true)

  files      File[]
  shares     Share[]
  shareLinks ShareLink[] @relation("CreatedShareLinks")

  @@index([email])
}

model File {
  id             String     @id
  ownerId        Int
  user           User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name           String
  mimeType       String
  size           BigInt
  fingerprint    String
  storageKey     String
  status         FileStatus @default(UPLOADING)
  uploadId       String?
  isFolder       Boolean    @default(false)
  parentFolderId String?
  parent         File?      @relation("FolderContents", fields: [parentFolderId], references: [id], onDelete: Cascade)
  children       File[]     @relation("FolderContents")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?
  version        Int        @default(1)

  fileChunks FileChunk[]
  shares     Share[]
  shareLinks ShareLink[]

  @@index([fingerprint])
  @@index([ownerId])
  @@index([parentFolderId])
}

enum FileStatus {
  UPLOADING
  UPLOADED
  DELETED
}

model FileChunk {
  id         String      @id
  fileId     String
  file       File        @relation(fields: [fileId], references: [id], onDelete: Cascade)
  partNumber Int
  etag       String?
  status     ChunkStatus @default(PENDING)

  @@unique([fileId, partNumber])
  @@index([fileId])
}

enum ChunkStatus {
  PENDING
  UPLOADING
  UPLOADED
}

model Share {
  id          String          @id
  fileId      String
  file        File            @relation(fields: [fileId], references: [id], onDelete: Cascade)
  userId      Int?
  user        User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  inviteEmail String
  permission  SharePermission @default(VIEW)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([fileId, inviteEmail])
  @@index([userId])
}

model ShareLink {
  id           String          @id
  token        String          @unique
  fileId       String
  file         File            @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdBy    Int
  creator      User            @relation("CreatedShareLinks", fields: [createdBy], references: [id], onDelete: Cascade)
  permission   SharePermission @default(VIEW)
  passwordHash String?
  expiresAt    DateTime?
  revokedAt    DateTime?
  createdAt    DateTime        @default(now())

  @@index([fileId])
}

enum SharePermission {
  VIEW
  EDIT
}
